# /opt/ai-stack/env/litellm.env  (mode 0600, root)
LITELLM_MASTER_KEY=<"sk" + "-" + openssl rand -hex 32; the prefix is required>
LITELLM_SALT_KEY=<openssl rand -hex 32; set once, never change>
DATABASE_URL=postgresql://litellm:<db password>@litellm-db:5432/litellm
OPENROUTER_API_KEY=<OpenRouter key used only by the gateway>
# DEEPSEEK_API_KEY=<optional, enables a deepseek-flash-direct alias>
