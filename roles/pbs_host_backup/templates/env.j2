# Managed by Ansible (pbs_host_backup). Read by the backup and notify scripts.
PBS_REPOSITORY={{ pbs_host_backup_repository | quote }}
PBS_PASSWORD={{ pbs_host_backup_token_secret | quote }}
{% if pbs_host_backup_fingerprint %}
PBS_FINGERPRINT={{ pbs_host_backup_fingerprint | quote }}
{% endif %}
PBS_HOST_BACKUP_WEBHOOK={{ pbs_host_backup_failure_webhook | quote }}
