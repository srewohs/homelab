# {{ ansible_managed }}
# Compare the [[outputs.influxdb_v2]] block below against a container that is
# already reporting correctly before trusting it. If your InfluxDB is 1.x,
# swap this for [[outputs.influxdb]] with database/username/password instead.

[agent]
  interval = "10s"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "10s"
  flush_jitter = "0s"
  precision = ""
  hostname = "{{ inventory_hostname }}"
  omit_hostname = false

[[outputs.influxdb_v2]]
  urls = ["{{ baseline_telegraf_influx_url }}"]
  token = "{{ baseline_telegraf_influx_token }}"
  organization = "{{ baseline_telegraf_influx_org }}"
  bucket = "{{ baseline_telegraf_influx_bucket }}"

[[inputs.cpu]]
  percpu = true
  totalcpu = true
  collect_cpu_time = false
  report_active = false

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "iso9660", "overlay", "aufs", "squashfs"]

[[inputs.diskio]]
[[inputs.mem]]
[[inputs.net]]
[[inputs.processes]]
[[inputs.swap]]
[[inputs.system]]

[[inputs.systemd_units]]
  unittype = "service"
